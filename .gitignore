
# Python virtual environment
.venv/

# Python cache files
__pycache__/
*.pyc

# Environment variables and secrets
.env
.env.*

# Jupyter temporary files
.ipynb_checkpoints/

# Raw and processed datasets
data/raw/*
data/processed/*
data/external/*

# Preserve empty data directories
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep
